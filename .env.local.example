# 이 파일을 복사해 `.env.local`로 저장한 뒤 값을 채우세요.
# `.env.local`은 Git에 커밋되지 않습니다.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key

# 서버 전용 — Vercel 환경 변수에도 넣되 "Production"만 또는 서버에서만 사용
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key

# 카카오 로그인 (서버에서만 사용 — REST API 키·시크릿은 절대 NEXT_PUBLIC_ 으로 두지 마세요)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://cellings.kr/auth/kakao/callback
